{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "study-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "study-tracker.sowndev.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "TRACKING_BUCKET",
      "bucket_name": "study-tracker-db",
      "preview_bucket_name": "study-tracker-db-preview"
    }
  ],
  "observability": {
    "enabled": true
  }
}
